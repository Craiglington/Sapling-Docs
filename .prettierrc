{
  "arrowParens": "always",
  "bracketSameLine": true,
  "singleQuote": false,
  "quoteProps": "consistent",
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "*.component.html",
      "options": {
        "parser": "html"
      }
    }
  ]
}
